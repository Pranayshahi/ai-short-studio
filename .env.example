# AI Shorts Studio Configuration

# Niche & Content
NICHE="Defense, Military & Advanced Technology"
TARGET_DURATION_SECONDS=25
TARGET_WORD_COUNT=55

# Voice configuration (Edge-TTS)
DEFAULT_VOICE="en-US-ChristopherNeural"

# AI API Keys (Optional - Free fallback generators work automatically without keys)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ACE-Step 1.5 (free, local): run `python -m acestep.api_server` in the ACE-Step-1.5 repo
ACESTEP_API_URL="http://127.0.0.1:8001"
ACESTEP_API_KEY=""

# Daily Automation Schedule (24h format, e.g. 20:00 is 8:00 PM IST)
SCHEDULE_TIME="20:00"
SCHEDULE_TIMEZONE="Asia/Kolkata"

# Phase 2 Automation: Instant Mobile Webhook Alerts
# Optional: Set either to receive instant notifications when daily videos are produced
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# YouTube Shorts Upload Settings
DEFAULT_PRIVACY_STATUS="private"  # 'private', 'public', or 'unlisted'

# Required by Wikimedia's User-Agent policy for real photo downloads (your email or a URL you control)
WIKIMEDIA_CONTACT=""

# Web Studio access
# Default binds to 127.0.0.1 (this computer only). If you expose it (STUDIO_HOST=0.0.0.0 or Docker),
# set a long random token and open the dashboard once with http://host:8000/?token=<token>
STUDIO_HOST="127.0.0.1"
STUDIO_API_TOKEN=""

# Free scene video clips (Add Clip button)
# Optional free Hugging Face token (type: Read) for more daily free GPU quota on the
# Wan 2.2 / LTX-2.3 Spaces: https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional overrides
# WAN_HF_SPACE=zerogpu-aoti/wan2-2-fp8da-aoti-faster
# LTX_HF_SPACE=Lightricks/LTX-2-3
# Local LTX-2.5 via the free Phosphene app: render size (multiples of 64). Phosphene caps Macs
# under 48 GB at 768 px on the long side, so the default is 448x768.
# PHOSPHENE_SIZE=448x768

# ---------------------------------------------------------------------------
# Hands-off automation (scheduler.py, installed with scripts/install_scheduler.sh)
# ---------------------------------------------------------------------------
# review = verified videos upload PRIVATE and you approve (Telegram button / dashboard)
# auto   = verified videos go PUBLIC automatically; anything unverified still waits for you
# off    = never upload automatically
AUTO_PUBLISH_MODE="review"
DAILY_SUMMARY_TIME="21:30"
HEALTH_CHECK_MINUTES=30
JOB_MAX_ATTEMPTS=3
# Start/stop ACE-Step automatically around music generation (one heavy AI service at a time)
ACESTEP_AUTO_MANAGE=1
# Set to 1 if the dashboard must always be up (otherwise its absence is not alerted)
DASHBOARD_REQUIRED=0
# Telegram = notifications + Approve/Reject buttons. Discord = notifications only.
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID / DISCORD_WEBHOOK_URL are defined above.

# ---------------------------------------------------------------------------
# Phase 2 quality (all free + local unless noted)
# ---------------------------------------------------------------------------
# AI scriptwriter: Qwen 2.5 7B via Ollama (brew install ollama; ollama pull qwen2.5:7b)
#   auto = use it when Ollama has the model, else template scripts; template = never
SCRIPT_WRITER="auto"
SCRIPT_WRITER_MODEL="qwen2.5:7b"
# Voice: kokoro (local, natural) or edge (Edge-TTS). Picking an Edge voice in the dashboard still uses Edge.
TTS_ENGINE="kokoro"
KOKORO_VOICE="am_michael"        # am_onyx, am_fenrir, bm_george ...
KOKORO_SPEED=1.15
# Extra photo sources (no key): NASA + Openverse (public-domain/CC Flickr incl. DVIDS & U.S. Army accounts).
# DVIDS API (optional) is restricted to U.S. citizens; leave empty otherwise.
DVIDS_API_KEY=""
# Motion clip for the opening scene: auto (free HF engines) | off | ltx23_hf | wan22_hf | phosphene_ltx
HOOK_CLIP_ENGINE="auto"
HOOK_CLIP_LOCAL=0                # 1 = also try local Phosphene (slow, uses most RAM)
HF_TOKEN=""                      # optional free Hugging Face token = more daily clip quota
# Overnight music library (ACE-Step), time of the nightly run
MUSIC_LIBRARY_TIME="02:30"
